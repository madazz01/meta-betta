{
  "name": "meta-betta",
  "displayName": "Meta Betta",
  "description": "The dev's assistant: a friendly chat panel on top of Muse Code, with a memory of you and your project.",
  "publisher": "madazz01",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:metaBetta.brain",
    "onView:metaBetta.brainSidebar",
    "onView:metaBetta.usage",
    "onView:metaBetta.sessions",
    "onCommand:metaBetta.open",
    "onCommand:metaBetta.saveMyDay",
    "onCommand:metaBetta.forgetApiKey"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Memory (brain folder) needs a trusted folder."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "metaBetta.open",
        "title": "Meta Betta: Open chat",
        "icon": "media/icon.svg"
      },
      {
        "command": "metaBetta.saveMyDay",
        "title": "Meta Betta: Save my day"
      },
      {
        "command": "metaBetta.forgetApiKey",
        "title": "Meta Betta: Forget my API key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "metaBetta",
          "title": "Meta Betta",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "metaBetta": [
        {
          "id": "metaBetta.usage",
          "type": "webview",
          "name": "Usage"
        },
        {
          "id": "metaBetta.sessions",
          "type": "webview",
          "name": "Sessions"
        },
        {
          "id": "metaBetta.brainSidebar",
          "type": "webview",
          "name": "Brain",
          "visibility": "collapsed"
        }
      ],
      "explorer": [
        {
          "id": "metaBetta.brain",
          "type": "webview",
          "name": "Brain",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "metaBetta.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Meta Betta",
      "properties": {
        "metaBetta.museBin": {
          "type": "string",
          "default": "",
          "description": "Path to the Muse binary. Leave empty to find it automatically."
        },
        "metaBetta.memory": {
          "type": "boolean",
          "default": true,
          "description": "Remember this folder in brain/ files that Muse reads every session. Needs a trusted folder."
        },
        "metaBetta.catchUpAfterHours": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "description": "Catch up with a brain summary when the last message is older than this many hours (or from an earlier day)."
        },
        "metaBetta.autoSaveMinutes": {
          "type": "number",
          "default": 45,
          "minimum": 0,
          "description": "Quietly save to the brain every so many minutes while chatting (0 = off). Also saves every 15 turns."
        },
        "metaBetta.backupFolder": {
          "type": "string",
          "default": "",
          "description": "Copy brain/ here after every save, under this workspace's folder name. Empty = off. Point it at a synced folder (Drive, OneDrive, Dropbox) for a free cloud copy."
        },
        "metaBetta.windowsSandboxWorkaround": {
          "type": "boolean",
          "default": true,
          "description": "Muse's Windows sandbox has a bug in serve mode. When on, the sandbox is off and Muse asks before every command."
        },
        "metaBetta.dingWhenDone": {
          "type": "boolean",
          "default": true,
          "description": "Play a soft chime when you've looked away and Muse needs you, or a long turn finishes."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@muse-code/sdk": "1.4.14"
  }
}
