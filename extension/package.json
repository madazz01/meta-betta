{
  "name": "meta-betta",
  "displayName": "Meta Betta",
  "description": "The dev's assistant: a friendly chat panel on top of Muse Code, with a memory of you and your project.",
  "publisher": "madazz01",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onView:metaBetta.chat",
    "onView:metaBetta.brain",
    "onCommand:metaBetta.open"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Memory (brain folder) needs a trusted folder."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "metaBetta.open",
        "title": "Meta Betta: Open chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "metaBetta",
          "title": "Meta Betta",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "metaBetta": [
        {
          "id": "metaBetta.chat",
          "type": "webview",
          "name": "Chat"
        }
      ],
      "explorer": [
        {
          "id": "metaBetta.brain",
          "type": "webview",
          "name": "Brain"
        }
      ]
    },
    "configuration": {
      "title": "Meta Betta",
      "properties": {
        "metaBetta.museBin": {
          "type": "string",
          "default": "",
          "description": "Path to the Muse binary. Leave empty to find it automatically."
        },
        "metaBetta.openIn": {
          "type": "string",
          "enum": ["editor", "sidebar"],
          "default": "editor",
          "description": "Where the Meta Betta chat lives: an editor tab or the side bar."
        },
        "metaBetta.memory": {
          "type": "boolean",
          "default": true,
          "description": "Remember this folder in brain/ files that Muse reads every session. Needs a trusted folder."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@muse-code/sdk": "1.4.14"
  }
}
